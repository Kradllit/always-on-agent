# Rust needs more stack than C's defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# After a crash, wait five seconds before restarting. Restarting in a tight loop froze
# this board solid on 2026-11-13 (no USB answer until it was power-cycled); with the wait,
# a firmware that crashes at once can still be replaced over USB, and the crash guard
# counts to three in its own time.
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=5

# The board: ESP32-S3R8, 16 MB flash, 8 MB PSRAM on eight data lines.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# The log goes out of the USB-C port (the chip's own USB serial), not a UART pin.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# All I2C here goes through the newer driver (bus.rs). ESP-IDF's older one still gets linked
# in, and without this it stops the firmware at start for finding the two together.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# Bluetooth LE through NimBLE (the esp32-nimble crate), its memory from PSRAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
